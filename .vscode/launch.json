    "version": "0.2.0",
    "configurations": [
        {
            "name": "Submit API",
            "type": "debugpy",
            "cwd": "${workspaceFolder}/submit-api/",
            "request": "launch",
            "program": "${workspaceFolder}/submit-api/wsgi.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Submit CRON - CENTRE",
            "type": "debugpy",
            "cwd": "${workspaceFolder}/submit-cron/",
            "request": "launch",
            "program": "${workspaceFolder}/submit-cron/invoke_jobs.py",
            "args": ["EMAIL", "CENTRE"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Submit CRON - SUBMIT",
            "type": "debugpy",
            "cwd": "${workspaceFolder}/submit-cron/",
            "request": "launch",
            "program": "${workspaceFolder}/submit-cron/invoke_jobs.py",
            "args": ["EMAIL", "SUBMIT"],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}